--- a/pyparsing/helpers.py
+++ b/pyparsing/helpers.py
@@ -1023,9 +1023,26 @@
 dbl_slash_comment = Regex(r"//(?:\\\n|[^\n])*").set_name("// comment")
 "Comment of the form ``// ... (to end of line)``"
 
-cpp_style_comment = Combine(
-    Regex(r"/\*(?:[^*]|\*(?!/))*") + "*/" | dbl_slash_comment
-).set_name("C++ style comment")
+class _CppCommentScanner(Token):
+    def parseImpl(self, instring, loc, do_actions=True):
+        if instring.startswith("/*", loc):
+            end = instring.find("*/", loc + 2)
+            if end >= 0:
+                end += 2
+                return end, instring[loc:end]
+        elif instring.startswith("//", loc):
+            end = loc + 2
+            while True:
+                end = instring.find("\n", end)
+                if end < 0:
+                    return len(instring), instring[loc:]
+                if instring[end - 1] != "\\":
+                    return end, instring[loc:end]
+                end += 1
+        raise ParseException(instring, loc, self.errmsg, self)
+
+
+cpp_style_comment = _CppCommentScanner().set_name("C++ style comment")
 "Comment of either form :class:`c_style_comment` or :class:`dbl_slash_comment`"
 
 java_style_comment = cpp_style_comment
