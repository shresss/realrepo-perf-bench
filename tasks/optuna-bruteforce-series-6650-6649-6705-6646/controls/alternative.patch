+    def _sync_finished_tree(
+        self, study: Study, trials: list[FrozenTrial], current_number: int
+    ) -> _FinishedTrialsTree | None:
+        # Return the incremental tree when it describes exactly the non-waiting trials other
+        # than the current one, i.e. when no other trial is running. Otherwise return None and
+        # let the caller rebuild from scratch.
+        cache = self._finished_tree
+        if cache is None or cache.storage is not study._storage or cache.study_id != study._study_id:
+            cache = self._finished_tree = _FinishedTrialsTree(study._storage, study._study_id)
+        if not cache.valid:
+            return None
+        seen = cache.seen
+        new_trials = []
+        for t in trials:
+            if t.number == current_number:
+                continue
+            if t.state == TrialState.RUNNING:
+                return None
+            if t.number not in seen:
+                new_trials.append(t)
+        if new_trials:
+            try:
+                self._populate_tree(cache.root, new_trials, {})
+            except Exception:
+                cache.valid = False
+                return None
+            seen.update(t.number for t in new_trials)
+        return cache
+
+    def _incremental_subtree(
+        self,
+        study: Study,
+        trials: list[FrozenTrial],
+        trial: FrozenTrial,
+        param_name: str,
+        candidates: Sequence[float],
+    ) -> _TreeNode | None:
+        # The subtree of finished trials sharing the current trial's params, rooted at
+        # `param_name`; identical to the from-scratch tree in `sample_independent`.
+        cache = self._sync_finished_tree(study, trials, trial.number)
+        if cache is None:
+            return None
+        node = cache.root
+        try:
+            for name, dist in trial.distributions.items():
+                if node.children is None:
+                    break  # No finished trial shares this prefix.
+                if node.param_name != name or not node.children:
+                    return None
+                child = node.children.get(dist.to_internal_repr(trial.params[name]))
+                if child is None:
+                    return None
+                node = child
+        except Exception:
+            return None
+        if node.children is None:
+            fresh = _TreeNode()
+            fresh.expand(param_name, candidates)
+            return fresh
+        if node.param_name != param_name or list(node.children) != list(candidates):
+            return None
+        return node
