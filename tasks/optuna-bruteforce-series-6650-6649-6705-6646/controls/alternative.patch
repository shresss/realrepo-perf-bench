+class _FinishedTrialsTree:
+    # Tree of all *finished* trials of one study, grown incrementally. Finished trials never
+    # change, so a trial is added exactly once. Running trials are never stored here.
+    __slots__ = ("storage", "study_id", "root", "seen", "valid")
+
+    def __init__(self, storage: Any, study_id: int) -> None:
+        self.storage = storage  # Strong reference: identity comparison stays sound.
+        self.study_id = study_id
+        self.root = _TreeNode()
+        self.seen: set[int] = set()
+        self.valid = True
+
