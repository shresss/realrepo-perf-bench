@@ -282,6 +294,32 @@ class SQLitePickleDict(SQLiteDict):
     def __getitem__(self, key):
         return self.serializer.loads(super().__getitem__(key))
 
+    def expired_or_invalid_keys(self):
+        """Keys of expired or undeserializable responses. Expiration times are memoized per
+        key and content digest, so only new or changed rows are deserialized again."""
+        memo = getattr(self, '_expiry_memo', {})
+        refreshed = {}
+        doomed = []
+        now = datetime.utcnow()
+        with self.connection() as con:
+            rows = con.execute(f'SELECT key, value FROM {self.table_name}').fetchall()
+        for key, value in rows:
+            digest = hashlib.blake2b(bytes(value), digest_size=16).digest()
+            cached = memo.get(key)
+            if cached is not None and cached[0] == digest:
+                expires = cached[1]
+            else:
+                try:
+                    expires = getattr(self.serializer.loads(value), 'expires', None)
+                except DESERIALIZE_ERRORS:
+                    doomed.append(key)
+                    continue
+            refreshed[key] = (digest, expires)
+            if expires is not None and now >= expires:
+                doomed.append(key)
+        self._expiry_memo = refreshed
+        return doomed
