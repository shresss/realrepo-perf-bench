+
+    def __deepcopy__(self, memo) -> InputColumn:
+        # The settings object is shared, read-only configuration owned by the linker:
+        # a copied column refers to it instead of duplicating the whole settings graph.
+        cls = self.__class__
+        new = cls.__new__(cls)
+        memo[id(self)] = new
+        for key, value in self.__dict__.items():
+            setattr(new, key, value if key == "_settings_obj" else deepcopy(value, memo))
+        return new
 
     def unquote(self) -> InputColumn:
         self_copy = deepcopy(self)
