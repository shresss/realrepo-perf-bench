+    # Drop ranges contained in another range of the same path. Visit them in
+    # (path, start, -end) order: every range seen earlier for the same path
+    # starts no later, so a range is contained iff an earlier one reaches its
+    # end. Identical ranges contain each other, so all copies are dropped.
+    remove = set()
+    order = sorted(
+        (i for i in range(len(paths)) if ends[i] is not None),
+        key=lambda i: (paths[i], starts[i], -ends[i]),
+    )
+    reach = None
+    for pos, i in enumerate(order):
+        path, start, end = paths[i], starts[i], ends[i]
+        if pos == 0 or paths[order[pos - 1]] != path:
+            reach = None
+        twin = any(
+            0 <= other < len(order)
+            and (paths[order[other]], starts[order[other]], ends[order[other]])
+            == (path, start, end)
+            for other in (pos - 1, pos + 1)
+        )
+        if twin or (reach is not None and reach >= end):
+            remove.add(i)
+        reach = end if reach is None else max(reach, end)
     paths = [p for i, p in enumerate(paths) if i not in remove]
     starts = [s for i, s in enumerate(starts) if i not in remove]
     ends = [e for i, e in enumerate(ends) if i not in remove]
