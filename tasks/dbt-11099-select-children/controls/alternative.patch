+    def _select_reachable(self, selected, max_depth, reverse):
+        # Materially different batch adjacency construction on each call, with
+        # multi-source shortest-distance traversal and no persistent stale cache.
+        from collections import deque
+        adjacency = {}
+        for parent, child, attributes in self.graph.edges(data=True):
+            if attributes.get("edge_type") != "parent_test":
+                origin, target = (child, parent) if reverse else (parent, child)
+                adjacency.setdefault(origin, []).append(target)
+        queue = deque((node, 0) for node in selected)
+        visited = set(selected)
+        result = set()
+        while queue:
+            node, depth = queue.popleft()
+            if max_depth is not None and depth >= max_depth:
+                continue
+            for target in adjacency.get(node, ()):
+                # Initial selections still count when reachable from another seed.
+                result.add(target)
+                if target not in visited:
+                    visited.add(target)
+                    queue.append((target, depth + 1))
+        return result
