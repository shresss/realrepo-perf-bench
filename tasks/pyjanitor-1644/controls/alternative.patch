diff --git a/janitor/functions/_conditional_join/_running_positions.py b/janitor/functions/_conditional_join/_running_positions.py
new file mode 100644
index 0000000..d683781
--- /dev/null
+++ b/janitor/functions/_conditional_join/_running_positions.py
@@ -0,0 +1,12 @@
+"""Original-position range summaries built with a Python scan."""
+import numpy as np
+
+
+def running_positions(index, keep):
+    result = np.empty(len(index), dtype=np.intp)
+    best = index[0]
+    choose = min if keep == "first" else max
+    for offset, position in enumerate(index):
+        best = choose(best, position)
+        result[offset] = best
+    return result
